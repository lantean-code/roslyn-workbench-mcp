                                        "properties": {
                                          "projectId": {
                                            "type": [
                                              "string",
                                              "null"
                                            ]
                                          },
                                          "name": {
                                            "type": [
                                              "string",
                                              "null"
                                            ]
                                          },
                                          "path": {
                                            "description": "Workspace-relative path.",
                                            "type": [
                                              "string",
                                              "null"
                                            ]
                                          },
                                          "targetFramework": {
                                            "type": [
                                              "string",
                                              "null"
                                            ]
                                          }
                                        }
                                      },
                                      "path": {
                                        "description": "Workspace-relative path.",
                                        "type": [
                                          "string",
                                          "null"
                                        ]
                                      },
                                      "documentId": {
                                        "description": "Workspace-local document ID.",
                                        "type": [
                                          "string",
                                          "null"
                                        ]
                                      }
                                    }
                                  },
                                  "range": {
                                    "description": "Zero-based UTF-16 range.",
                                    "type": "object",
                                    "properties": {
                                      "start": {
                                        "description": "Zero-based UTF-16 offset.",
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 2147483647
                                      },
                                      "length": {
                                        "description": "UTF-16 code-unit length.",
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 2147483647
                                      }
                                    }
                                  }
                                },
                                "required": [
                                  "document",
                                  "range"
                                ]
                              }
                            },
                            "required": [
                              "span"
                            ]
                          }
                        },
