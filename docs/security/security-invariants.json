          "test": "Roslyn.Workbench.Mcp.Workspace.Test.Lifecycle.WorkspaceLifecycleServiceTests.GIVEN_PathOutsideHostAuthority_WHEN_OpeningWorkspace_THEN_ShouldRejectBeforeLoading"
