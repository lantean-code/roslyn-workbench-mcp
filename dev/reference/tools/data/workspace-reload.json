                      "id": {
                        "description": "The diagnostic identifier.",
                        "type": "string"
                      },
                      "severity": {
                        "description": "The diagnostic severity.",
                        "type": "string",
                        "enum": [
                          "Hidden",
                          "Info",
                          "Warning",
                          "Error"
                        ]
                      },
                      "message": {
                        "description": "The diagnostic message.",
                        "type": "string"
                      },
                      "location": {
                        "description": "The optional source location of the diagnostic.",
