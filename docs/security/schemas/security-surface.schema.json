{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "security-surface.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "items"],
  "properties": {
    "$schema": { "const": "schemas/security-surface.schema.json" },
    "format": { "const": "roslyn-workbench-security-surface/v1" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "category", "facts"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "facts": { "type": "object", "minProperties": 1, "propertyNames": { "minLength": 1 } }
        }
      }
    }
  }
}
