      "id": "coordinated-workspace-ownership",
      "title": "Workspace mutation requires coordinated local ownership",
      "classification": "delegated",
      "actor": "Authorised MCP client, user and other local workspace editors",
      "outcome": "Callers wait for recovery initialisation and avoid concurrent file edits or workspace-topology changes while non-cancellable commit application or recovery is in progress. A second Host instance sharing the same workspace remains advisory or query-only.",
      "boundary": "Roslyn Workbench detects many stale-input and external-change conditions, but it does not hold an operating-system lock over every workspace file or coordinate independent Host processes.",
      "residualRisk": "Uncoordinated local writers can invalidate assumptions during the narrow persistence boundary and can require recovery or manual reconciliation.",
      "surfaceKeys": [],
      "evidence": []
    },
    {
      "id": "authorised-client-responsibility",
      "title": "The client and user remain responsible for intent and review",
      "classification": "delegated",
      "actor": "Authorised MCP client and user",
      "outcome": "The client should use inspection before mutation, convey elicitation failures accurately, review previews or receipts and keep each transaction to a coherent change.",
      "boundary": "Roslyn Workbench supplies bounded tools, structured continuations and exact review data; it cannot determine the user's true intent.",
      "residualRisk": "A mistaken but authorised approval can persist an undesirable change that satisfies all mechanical safeguards.",
      "surfaceKeys": [],
      "evidence": []
    },
    {
      "id": "trusted-local-execution-boundary",
      "title": "Roslyn Workbench is not a hostile-code sandbox",
      "classification": "limitation",
      "actor": "Operating environment and repository owner",
      "outcome": "Workspaces, builds, analysers, generators, Code Action providers and enabled plugins must be trusted for local execution.",
      "boundary": "The server is local and stdio-based, but trusted extensions and build inputs execute with the Host process authority.",
      "residualRisk": "Hostile code with the same operating-system authority can bypass application-level controls and access local data directly.",
      "surfaceKeys": [
        "plugin-loading:execution-boundary"
