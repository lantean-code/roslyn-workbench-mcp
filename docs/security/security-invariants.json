      "id": "compiler-impact-validation",
      "title": "Optional compiler-impact validation fails closed",
      "classification": "enforced",
      "actor": "Roslyn Workbench transaction pipeline",
      "outcome": "When configured, commit is blocked by new compiler errors or incomplete compiler evaluation relative to the transaction baseline.",
      "boundary": "The validation covers the projects and compilations affected by the staged transaction at commit time.",
      "residualRisk": "It does not prove behavioural correctness, run all analysers or replace repository builds and tests.",
      "surfaceKeys": [
        "compiler-error-identity:compiler-error-identity-v1",
        "error:CompilerValidationIncomplete",
        "error:CompilerValidationUnavailable",
        "error:NewCompilerErrors"
