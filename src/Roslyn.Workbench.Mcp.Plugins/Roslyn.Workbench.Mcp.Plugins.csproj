<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Lantean.Roslyn.Workbench.Mcp.Plugins</PackageId>
    <Title>Roslyn Workbench MCP Plugin Authoring</Title>
    <Authors>Lantean Code</Authors>
    <Company>Lantean Code</Company>
    <Copyright>Copyright © 2026 Lantean Code</Copyright>
    <Description>Trusted in-process plugin contracts and authoring diagnostics for Roslyn Workbench MCP.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://lantean-code.github.io/roslyn-workbench-mcp/latest/plugin-authoring.html</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>roslyn-workbench-mcp-128.png</PackageIcon>
    <PackageTags>model-context-protocol;mcp;roslyn;csharp;dotnet;plugins;analyzers</PackageTags>
    <PackageReleaseNotes>https://github.com/lantean-code/roslyn-workbench-mcp/releases/tag/$(RoslynWorkbenchSourceTag)</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\PluginAuthoring.md"
          Pack="true"
          PackagePath="README.md" />
    <None Include="..\..\LICENSE"
          Pack="true"
          PackagePath="\" />
    <None Include="..\..\assets\icons\roslyn-workbench-mcp-128.png"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <Compile Include="..\Roslyn.Workbench.Mcp.Plugins.Analyzers\Shared\PluginToolNamePolicy.cs"
             Link="Validation\PluginToolNamePolicy.cs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="System.Composition" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\Roslyn.Workbench.Mcp.Plugins.Analyzers\Roslyn.Workbench.Mcp.Plugins.Analyzers.csproj"
      ReferenceOutputAssembly="false" />
    <ProjectReference
      Include="..\Roslyn.Workbench.Mcp.Abstractions\Roslyn.Workbench.Mcp.Abstractions.csproj"
      PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);IncludePluginAnalyzersInPackage;IncludePluginAbstractionsInPackage
    </TargetsForTfmSpecificContentInPackage>
    <TargetsForTfmSpecificDebugSymbolsInPackage>
      $(TargetsForTfmSpecificDebugSymbolsInPackage);IncludePluginAbstractionsSymbolsInPackage
    </TargetsForTfmSpecificDebugSymbolsInPackage>
  </PropertyGroup>

  <Target Name="IncludePluginAnalyzersInPackage">
    <MSBuild
      Projects="..\Roslyn.Workbench.Mcp.Plugins.Analyzers\Roslyn.Workbench.Mcp.Plugins.Analyzers.csproj"
      Targets="GetTargetPath"
      RemoveProperties="TargetFramework">
      <Output
        TaskParameter="TargetOutputs"
        ItemName="_PluginAnalyzerAssembly" />
    </MSBuild>

    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_PluginAnalyzerAssembly)">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="IncludePluginAbstractionsInPackage">
    <MSBuild
      Projects="..\Roslyn.Workbench.Mcp.Abstractions\Roslyn.Workbench.Mcp.Abstractions.csproj"
      Targets="GetTargetPath">
      <Output
        TaskParameter="TargetOutputs"
        ItemName="_PluginAbstractionsAssembly" />
    </MSBuild>

    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_PluginAbstractionsAssembly)">
        <PackagePath>lib/$(TargetFramework)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="IncludePluginAbstractionsSymbolsInPackage">
    <MSBuild
      Projects="..\Roslyn.Workbench.Mcp.Abstractions\Roslyn.Workbench.Mcp.Abstractions.csproj"
      Targets="DebugSymbolsProjectOutputGroup">
      <Output
        TaskParameter="TargetOutputs"
        ItemName="_PluginAbstractionsSymbols" />
    </MSBuild>

    <ItemGroup>
      <TfmSpecificDebugSymbolsFile Include="@(_PluginAbstractionsSymbols)">
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </TfmSpecificDebugSymbolsFile>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.Plugins.Core</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.Plugins.Test</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.IntegrationTest</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.TestSupport</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.IntegrationTestSupport</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.Plugins.Core.Test</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.Workspace.IntegrationTest</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.Test</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.ToolReferenceGenerator</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
