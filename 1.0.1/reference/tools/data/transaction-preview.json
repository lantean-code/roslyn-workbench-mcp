  "name": "transaction-preview",
  "title": "Transaction Preview",
  "area": "Server",
  "category": "Transactions",
  "operationKind": "Query",
  "summary": "Previews the current staged transaction.",
  "availability": "Published only in transactional and autonomous-trusted operational modes.",
  "documentationUrl": "https://lantean-code.github.io/roslyn-workbench-mcp/1.0.1/reference/tools/transaction-preview.html",
  "tool": {
    "name": "transaction-preview",
    "title": "Transaction Preview",
    "description": "Previews the current staged transaction.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "document": {
          "description": "Document whose detailed diff should be returned; provide it when includeDiff is true.",
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "project": {
              "description": "Disambiguates documents with matching paths or IDs.",
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "projectId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "path": {
                  "description": "Workspace-relative path.",
                  "type": "string"
                },
                "targetFramework": {
                  "type": "string"
                }
              }
            },
            "path": {
              "description": "Workspace-relative path.",
              "type": "string"
            },
            "documentId": {
              "description": "Workspace-local document ID.",
              "type": "string"
            }
          }
        },
        "includeDiff": {
          "description": "Whether to include a detailed diff.",
          "type": "boolean"
        },
        "contextLines": {
          "description": "Number of unchanged context lines around each diff hunk when includeDiff is true.",
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 3
        },
        "workspace": {
          "description": "Provide workspaceId, alias, path, or any combination.",
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "workspaceId": {
              "type": "string",
              "format": "uuid"
            },
            "alias": {
              "type": "string"
            },
            "path": {
              "description": "Absolute workspace path.",
              "type": "string"
            }
          }
        }
      }
    },
