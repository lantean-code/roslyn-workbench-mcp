<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Keep the analyser's compiler API baseline independent from the Host's Roslyn
    runtime. Raising Microsoft.CodeAnalysis.CSharp can prevent the analyser from
    loading in otherwise supported compiler and IDE hosts.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0-1.26328.17" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
