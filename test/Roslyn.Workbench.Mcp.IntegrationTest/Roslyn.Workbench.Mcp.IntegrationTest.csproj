<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);MCPEXP002</NoWarn>
    <RootNamespace>Roslyn.Workbench.Mcp.Test</RootNamespace>
    <TestCategory>Integration</TestCategory>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryRoot" Value="$(MSBuildProjectDirectory)/../.." />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Roslyn.Workbench.Mcp\Roslyn.Workbench.Mcp.csproj" />
    <ProjectReference Include="..\Roslyn.Workbench.Mcp.IntegrationTestSupport\Roslyn.Workbench.Mcp.IntegrationTestSupport.csproj" />
    <ProjectReference Include="..\TestFixtures\Plugins\Roslyn.Workbench.Mcp.HostMutationPluginFixture\Roslyn.Workbench.Mcp.HostMutationPluginFixture.csproj" />
    <ProjectReference Include="..\TestFixtures\Plugins\Roslyn.Workbench.Mcp.HostQueryPluginFixture\Roslyn.Workbench.Mcp.HostQueryPluginFixture.csproj" />
    <ProjectReference Include="..\TestFixtures\Plugins\Roslyn.Workbench.Mcp.InvalidPluginFixture\Roslyn.Workbench.Mcp.InvalidPluginFixture.csproj" />
    <ProjectReference Include="..\TestFixtures\Plugins\Roslyn.Workbench.Mcp.ThrowingPluginFixture\Roslyn.Workbench.Mcp.ThrowingPluginFixture.csproj" />
  </ItemGroup>

  <Target Name="CopyPluginPackageAssets" AfterTargets="Build">
    <ItemGroup>
      <HostQueryPluginAssembly Include="@(ReferenceCopyLocalPaths)"
                               Condition="'%(Filename)' == 'Roslyn.Workbench.Mcp.HostQueryPluginFixture' and '%(Extension)' == '.dll'" />
      <HostQueryPluginPackageAsset Include="@(HostQueryPluginAssembly)" />
      <HostQueryPluginPackageAsset Include="@(HostQueryPluginAssembly->'%(RootDir)%(Directory)%(Filename).deps.json')" />
      <HostQueryPluginPackageAsset Include="@(ReferenceCopyLocalPaths)"
                                   Condition="'%(Filename)' == 'NuGet.Versioning'" />
      <HostMutationPluginPackageAsset Include="@(ReferenceCopyLocalPaths)"
                                      Condition="'%(Filename)' == 'Roslyn.Workbench.Mcp.HostMutationPluginFixture' and '%(Extension)' == '.dll'" />
      <InvalidPluginPackageAsset Include="@(ReferenceCopyLocalPaths)"
                                 Condition="'%(Filename)' == 'Roslyn.Workbench.Mcp.InvalidPluginFixture' and '%(Extension)' == '.dll'" />
      <ThrowingPluginPackageAsset Include="@(ReferenceCopyLocalPaths)"
                                  Condition="'%(Filename)' == 'Roslyn.Workbench.Mcp.ThrowingPluginFixture' and '%(Extension)' == '.dll'" />
    </ItemGroup>
    <Copy SourceFiles="@(HostQueryPluginPackageAsset)" DestinationFolder="$(OutDir)/PluginFixtureAssets/HostQuery" />
    <Copy SourceFiles="@(HostQueryPluginPackageAsset)" DestinationFolder="$(OutDir)/PluginFixtureAssets/Catalog/Valid/00-HostQuery" />
    <Copy SourceFiles="@(HostMutationPluginPackageAsset)" DestinationFolder="$(OutDir)/PluginFixtureAssets/Catalog/Valid/01-HostMutation" />
    <Copy SourceFiles="@(InvalidPluginPackageAsset)" DestinationFolder="$(OutDir)/PluginFixtureAssets/Catalog/Valid/02-Invalid" />
    <Copy SourceFiles="@(HostQueryPluginPackageAsset)" DestinationFolder="$(OutDir)/PluginFixtureAssets/Catalog/ReservedCollision/00-HostQuery" />
    <Copy SourceFiles="@(HostQueryPluginPackageAsset)" DestinationFolder="$(OutDir)/PluginFixtureAssets/Catalog/Duplicate/00-HostQuery" />
    <Copy SourceFiles="@(HostQueryPluginPackageAsset)" DestinationFolder="$(OutDir)/PluginFixtureAssets/Catalog/Duplicate/01-HostQuery" />
    <Copy SourceFiles="@(ThrowingPluginPackageAsset)" DestinationFolder="$(OutDir)/PluginFixtureAssets/Catalog/Throwing/00-Throwing" />
  </Target>

</Project>
