    <IsTestProject>true</IsTestProject>
    <RootNamespace>Roslyn.Workbench.Mcp.CodeActions.Test</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepositoryRoot" Value="$(MSBuildProjectDirectory)\..\.." />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Roslyn.Workbench.Mcp.CodeActions\Roslyn.Workbench.Mcp.CodeActions.csproj" />
