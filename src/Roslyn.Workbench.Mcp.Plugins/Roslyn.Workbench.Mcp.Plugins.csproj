<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Authors>lantean-code</Authors>
    <Description>Trusted in-process plugin contracts and authoring diagnostics for Roslyn Workbench MCP.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lantean-code/roslyn-workbench-mcp</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>mcp;roslyn;plugins;analyzers</PackageTags>
    <RepositoryUrl>https://github.com/lantean-code/roslyn-workbench-mcp.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\PluginAuthoring.md"
          Pack="true"
          PackagePath="README.md" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="System.Composition" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\Roslyn.Workbench.Mcp.Plugins.Analyzers\Roslyn.Workbench.Mcp.Plugins.Analyzers.csproj"
      ReferenceOutputAssembly="false" />
    <ProjectReference
      Include="..\Roslyn.Workbench.Mcp.Abstractions\Roslyn.Workbench.Mcp.Abstractions.csproj"
      PrivateAssets="all" />
    <ProjectReference
      Include="..\Roslyn.Workbench.Mcp.Workspace\Roslyn.Workbench.Mcp.Workspace.csproj"
      PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);IncludePluginAnalyzersInPackage;IncludePluginAbstractionsInPackage
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="IncludePluginAnalyzersInPackage">
    <MSBuild
      Projects="..\Roslyn.Workbench.Mcp.Plugins.Analyzers\Roslyn.Workbench.Mcp.Plugins.Analyzers.csproj"
      Targets="GetTargetPath">
      <Output
        TaskParameter="TargetOutputs"
        ItemName="_PluginAnalyzerAssembly" />
    </MSBuild>

    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_PluginAnalyzerAssembly)">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <Target Name="IncludePluginAbstractionsInPackage">
    <MSBuild
      Projects="..\Roslyn.Workbench.Mcp.Abstractions\Roslyn.Workbench.Mcp.Abstractions.csproj"
      Targets="GetTargetPath">
      <Output
        TaskParameter="TargetOutputs"
        ItemName="_PluginAbstractionsAssembly" />
    </MSBuild>

    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_PluginAbstractionsAssembly)">
        <PackagePath>lib/$(TargetFramework)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.Plugins.Core</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.Plugins.Test</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.IntegrationTest</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.TestSupport</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.IntegrationTestSupport</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.Plugins.Core.Test</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.Workspace.IntegrationTest</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
