      "id": "transaction-snapshot-and-receipt",
      "title": "Mutations remain transaction-, snapshot- and approval-bound",
      "classification": "enforced",
      "actor": "Roslyn Workbench transaction pipeline",
      "outcome": "Source mutations require an active transaction, stale snapshots are rejected, and approval-required commits use a one-use receipt bound to the exact reviewed persistence set.",
      "boundary": "The guarantee covers mutations and commits routed through the supported transaction tools and lower-level transaction service.",
      "residualRisk": "A user or authorised client can approve an undesirable but accurately represented change; repository review remains necessary.",
      "surfaceKeys": [
        "continuation:call-tool",
        "continuation:choose-tool",
        "continuation:resolve-externally",
