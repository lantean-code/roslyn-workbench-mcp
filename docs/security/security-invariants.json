      "id": "plugin-loading-boundary",
      "title": "External plugin loading is explicit and mode-constrained",
      "classification": "enforced",
      "actor": "Roslyn Workbench Host",
      "outcome": "External plugin discovery is disabled by default and fixed at startup. Plugin mutation tools are published only when the resolved operational policy enables source mutation.",
      "boundary": "The Host controls discovery and publication. Once loaded, trusted plugins execute in process with Host authority.",
      "residualRisk": "Plugins, analysers and Code Action providers are trusted code rather than sandboxed tenants and can perform effects outside MCP tool contracts.",
