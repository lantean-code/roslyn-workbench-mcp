      "id": "workspace-authority-and-document-policy",
      "title": "Workspace authority constrains admitted and mutable files",
      "classification": "enforced",
      "actor": "Roslyn Workbench Host",
      "outcome": "Workspace admission, external-document handling and mutation containment are evaluated against Host-owned authority rather than client assertions.",
      "boundary": "The guarantee covers workspaces and transaction persistence performed through Roslyn Workbench.",
      "residualRisk": "Other local processes and trusted build inputs can change files outside this Host and can require a workspace reload.",
      "surfaceKeys": [
        "policy:external-document:allow-read-only",
        "policy:external-document:reject-workspace",
        "status-field:allowedWorkspaceRootCount",
        "status-field:externalDocumentPolicy",
        "status-field:workspaceAdmission",
