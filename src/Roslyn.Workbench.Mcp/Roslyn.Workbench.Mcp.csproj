<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Roslyn.Workbench.Mcp</AssemblyName>
    <AssemblyTitle>Roslyn Workbench MCP</AssemblyTitle>
    <Product>Roslyn Workbench MCP</Product>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>roslyn-workbench-mcp</ToolCommandName>
    <PackageId>Lantean.Roslyn.Workbench.Mcp</PackageId>
    <Title>Roslyn Workbench MCP</Title>
    <Description>A local MCP server for Roslyn-powered C# code analysis and safe, transactional refactoring.</Description>
    <Authors>Lantean Code</Authors>
    <Company>Lantean Code</Company>
    <Copyright>Copyright © 2026 Lantean Code</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://lantean-code.github.io/roslyn-workbench-mcp/</PackageProjectUrl>
    <PackageTags>model-context-protocol;mcp;mcp-server;roslyn;csharp;dotnet;code-analysis;refactoring;developer-tools</PackageTags>
    <PackageIcon>roslyn-workbench-mcp-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/lantean-code/roslyn-workbench-mcp/releases/tag/$(RoslynWorkbenchSourceTag)</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <BeforePack>$(BeforePack);PreparePackageReadme</BeforePack>
    <!-- The Host is an executable .NET tool; its supported compatibility surfaces are MCP contracts and command-line behaviour, not its CLR API. -->
    <EnablePackageValidation>false</EnablePackageValidation>
    <PackageReadmeSource>$(MSBuildProjectDirectory)\..\..\README.md</PackageReadmeSource>
    <PackageReadmeOutput>$(BaseIntermediateOutputPath)PackageREADME.md</PackageReadmeOutput>
    <PackageWordmarkSource>assets/roslyn-workbench-mcp-wordmark.svg</PackageWordmarkSource>
    <PackageWordmarkUrl>https://raw.githubusercontent.com/lantean-code/roslyn-workbench-mcp/$(RoslynWorkbenchSourceTag)/assets/roslyn-workbench-mcp-wordmark.svg</PackageWordmarkUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="Sentry" />
    <PackageReference Include="System.Composition" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Roslyn.Workbench.Mcp.Abstractions\Roslyn.Workbench.Mcp.Abstractions.csproj" />
    <ProjectReference Include="..\Roslyn.Workbench.Mcp.CodeActions\Roslyn.Workbench.Mcp.CodeActions.csproj" />
    <ProjectReference Include="..\Roslyn.Workbench.Mcp.Workspace\Roslyn.Workbench.Mcp.Workspace.csproj" />
    <ProjectReference Include="..\Roslyn.Workbench.Mcp.Plugins\Roslyn.Workbench.Mcp.Plugins.csproj" />
    <ProjectReference Include="..\Roslyn.Workbench.Mcp.Plugins.Core\Roslyn.Workbench.Mcp.Plugins.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\THIRD-PARTY-NOTICES.md"
             Link="THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="true"
             PackagePath="\" />
    <Content Include="..\..\THIRD-PARTY-LICENSES\AsyncFixer.txt"
             Link="THIRD-PARTY-LICENSES\AsyncFixer.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="true"
             PackagePath="THIRD-PARTY-LICENSES" />
    <None Include="..\..\LICENSE"
          Pack="true"
          PackagePath="\" />
    <None Include="..\..\assets\icons\roslyn-workbench-mcp-128.png"
          Pack="true"
          PackagePath="\"
          Visible="false" />
    <None Include="$(PackageReadmeOutput)"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="Sentry.DsnAttribute" Condition="'$(ROSLYN_WORKBENCH_SENTRY_DSN)' != ''">
      <_Parameter1>$(ROSLYN_WORKBENCH_SENTRY_DSN)</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.Test</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.IntegrationTest</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.IntegrationTestSupport</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Roslyn.Workbench.Mcp.ToolReferenceGenerator</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="PreparePackageReadme">
    <PropertyGroup>
      <_PackageReadmeContents>$([System.IO.File]::ReadAllText('$(PackageReadmeSource)').Replace('$(PackageWordmarkSource)', '$(PackageWordmarkUrl)'))</_PackageReadmeContents>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(PackageReadmeOutput)'))" />
    <WriteLinesToFile File="$(PackageReadmeOutput)"
                      Lines="$(_PackageReadmeContents)"
                      Overwrite="true" />
  </Target>

</Project>
