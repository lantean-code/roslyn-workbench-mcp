<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);MCPEXP002</NoWarn>
    <RootNamespace>Roslyn.Workbench.Mcp.AcceptanceTest</RootNamespace>
    <TestCategory>Integration</TestCategory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestFixtures\Plugins\Roslyn.Workbench.Mcp.HostQueryPluginFixture.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\TestAssets\Workspaces\SdkProject\**\*">
      <Link>TestAssets\Workspaces\SdkProject\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TestAssets\Workspaces\InspectionSample\Base\**\*">
      <Link>TestAssets\Workspaces\InspectionSample\Base\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyHostQueryPluginPackageAssets" AfterTargets="Build">
    <ItemGroup>
      <HostQueryPluginProject Include="@(ProjectReference)"
                              Condition="'%(Filename)' == 'Roslyn.Workbench.Mcp.HostQueryPluginFixture'" />
    </ItemGroup>
    <MSBuild Projects="@(HostQueryPluginProject)"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)"
             Properties="Configuration=$(Configuration);Platform=$(Platform);ArtifactsPath=$(ArtifactsPath)">
      <Output TaskParameter="TargetOutputs" ItemName="HostQueryPluginAssembly" />
    </MSBuild>
    <ItemGroup>
      <HostQueryPluginPackageAsset Include="@(HostQueryPluginAssembly)" />
      <HostQueryPluginPackageAsset Include="@(HostQueryPluginAssembly->'%(RootDir)%(Directory)%(Filename).deps.json')" />
      <HostQueryPluginPackageAsset Include="@(HostQueryPluginAssembly->'%(RootDir)%(Directory)NuGet.Versioning.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(HostQueryPluginPackageAsset)" DestinationFolder="$(OutDir)/TestAssets/Plugins/HostQuery" />
  </Target>

</Project>
