<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);MCPEXP002</NoWarn>
    <RootNamespace>Roslyn.Workbench.Mcp.AcceptanceTest</RootNamespace>
    <TestCategory>Integration</TestCategory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TestFixtures\Plugins\Roslyn.Workbench.Mcp.HostQueryPluginFixture\Roslyn.Workbench.Mcp.HostQueryPluginFixture.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TestFixtures\Plugins\Roslyn.Workbench.Mcp.HostMutationPluginFixture\Roslyn.Workbench.Mcp.HostMutationPluginFixture.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TestFixtures\Plugins\Roslyn.Workbench.Mcp.InvalidPluginFixture\Roslyn.Workbench.Mcp.InvalidPluginFixture.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TestFixtures\Plugins\Roslyn.Workbench.Mcp.ThrowingPluginFixture\Roslyn.Workbench.Mcp.ThrowingPluginFixture.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\TestAssets\CodeActionAcceptanceToolNames.txt">
      <Link>TestAssets\CodeActionAcceptanceToolNames.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TestAssets\Workspaces\SdkProject\**\*">
      <Link>TestAssets\Workspaces\SdkProject\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TestAssets\Workspaces\InspectionSample\Base\**\*">
      <Link>TestAssets\Workspaces\InspectionSample\Base\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TestAssets\Workspaces\SolutionHierarchy\**\*">
      <Link>TestAssets\Workspaces\SolutionHierarchy\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TestAssets\Workspaces\CompatibilitySamples\MixedSolution\**\*">
      <Link>TestAssets\Workspaces\CompatibilitySamples\MixedSolution\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TestAssets\Workspaces\CompatibilitySamples\MalformedSdkProject\**\*">
      <Link>TestAssets\Workspaces\CompatibilitySamples\MalformedSdkProject\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\TestAssets\Workspaces\MultiTargetLinked\**\*">
      <Link>TestAssets\Workspaces\MultiTargetLinked\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyHostQueryPluginPackageAssets" AfterTargets="Build">
    <ItemGroup>
      <HostQueryPluginProject Include="@(ProjectReference)"
                              Condition="'%(Filename)' == 'Roslyn.Workbench.Mcp.HostQueryPluginFixture'" />
    </ItemGroup>
    <MSBuild Projects="@(HostQueryPluginProject)"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)"
             Properties="Configuration=$(Configuration);Platform=$(Platform);ArtifactsPath=$(ArtifactsPath)">
      <Output TaskParameter="TargetOutputs" ItemName="HostQueryPluginAssembly" />
    </MSBuild>
    <ItemGroup>
      <HostQueryPluginPackageAsset Include="@(HostQueryPluginAssembly)" />
      <HostQueryPluginPackageAsset Include="@(HostQueryPluginAssembly->'%(RootDir)%(Directory)%(Filename).deps.json')" />
      <HostQueryPluginPackageAsset Include="@(HostQueryPluginAssembly->'%(RootDir)%(Directory)NuGet.Versioning.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(HostQueryPluginPackageAsset)" DestinationFolder="$(OutDir)/TestAssets/Plugins/HostQuery" />
  </Target>

  <Target Name="CopyHostMutationPluginPackageAssets" AfterTargets="Build">
    <ItemGroup>
      <HostMutationPluginProject Include="@(ProjectReference)"
                                Condition="'%(Filename)' == 'Roslyn.Workbench.Mcp.HostMutationPluginFixture'" />
    </ItemGroup>
    <MSBuild Projects="@(HostMutationPluginProject)"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)"
             Properties="Configuration=$(Configuration);Platform=$(Platform);ArtifactsPath=$(ArtifactsPath)">
      <Output TaskParameter="TargetOutputs" ItemName="HostMutationPluginAssembly" />
    </MSBuild>
    <ItemGroup>
      <HostMutationPluginPackageAsset Include="@(HostMutationPluginAssembly)" />
      <HostMutationPluginPackageAsset Include="@(HostMutationPluginAssembly->'%(RootDir)%(Directory)%(Filename).deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(HostMutationPluginPackageAsset)" DestinationFolder="$(OutDir)/TestAssets/Plugins/HostMutation" />
  </Target>

  <Target Name="CopyInvalidPluginPackageAssets" AfterTargets="Build">
    <ItemGroup>
      <InvalidPluginProject Include="@(ProjectReference)"
                            Condition="'%(Filename)' == 'Roslyn.Workbench.Mcp.InvalidPluginFixture'" />
    </ItemGroup>
    <MSBuild Projects="@(InvalidPluginProject)"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)"
             Properties="Configuration=$(Configuration);Platform=$(Platform);ArtifactsPath=$(ArtifactsPath)">
      <Output TaskParameter="TargetOutputs" ItemName="InvalidPluginAssembly" />
    </MSBuild>
    <ItemGroup>
      <InvalidPluginPackageAsset Include="@(InvalidPluginAssembly)" />
      <InvalidPluginPackageAsset Include="@(InvalidPluginAssembly->'%(RootDir)%(Directory)%(Filename).deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(InvalidPluginPackageAsset)" DestinationFolder="$(OutDir)/TestAssets/Plugins/Invalid" />
  </Target>

  <Target Name="CopyThrowingPluginPackageAssets" AfterTargets="Build">
    <ItemGroup>
      <ThrowingPluginProject Include="@(ProjectReference)"
                             Condition="'%(Filename)' == 'Roslyn.Workbench.Mcp.ThrowingPluginFixture'" />
    </ItemGroup>
    <MSBuild Projects="@(ThrowingPluginProject)"
             Targets="GetTargetPath"
             BuildInParallel="$(BuildInParallel)"
             Properties="Configuration=$(Configuration);Platform=$(Platform);ArtifactsPath=$(ArtifactsPath)">
      <Output TaskParameter="TargetOutputs" ItemName="ThrowingPluginAssembly" />
    </MSBuild>
    <ItemGroup>
      <ThrowingPluginPackageAsset Include="@(ThrowingPluginAssembly)" />
      <ThrowingPluginPackageAsset Include="@(ThrowingPluginAssembly->'%(RootDir)%(Directory)%(Filename).deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(ThrowingPluginPackageAsset)" DestinationFolder="$(OutDir)/TestAssets/Plugins/Throwing" />
  </Target>

</Project>
