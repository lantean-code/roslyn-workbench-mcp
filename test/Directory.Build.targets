<Project>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <NoWarn>$(NoWarn);CA1707</NoWarn>
    <ExpectedTestCategory Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.IntegrationTest'))">Integration</ExpectedTestCategory>
    <ExpectedTestCategory Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.AcceptanceTest'))">Integration</ExpectedTestCategory>
    <ExpectedTestCategory Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.AuditTest'))">Audit</ExpectedTestCategory>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true' And '$(TestCategory)' != ''">
    <AssemblyAttribute Include="Xunit.TraitAttribute">
      <_Parameter1>Category</_Parameter1>
      <_Parameter2>$(TestCategory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="ValidateTestProjectCategory" BeforeTargets="CoreCompile" Condition="'$(IsTestProject)' == 'true'">
    <Error Condition="'$(ExpectedTestCategory)' != '' And '$(TestCategory)' != '$(ExpectedTestCategory)'"
           Text="Test project '$(MSBuildProjectName)' must set TestCategory to '$(ExpectedTestCategory)'." />
    <Error Condition="'$(ExpectedTestCategory)' == '' And '$(TestCategory)' != ''"
           Text="Test project '$(MSBuildProjectName)' may set TestCategory only when its name ends with IntegrationTest, AcceptanceTest or AuditTest; Unit and Contract projects must leave TestCategory empty." />
  </Target>

  <Target Name="ValidateTestSupportProjectReferences" BeforeTargets="ResolveProjectReferences">
    <ItemGroup>
      <_IntegrationTestSupportReference Include="@(ProjectReference)"
                                        Condition="'%(Filename)' == 'Roslyn.Workbench.Mcp.IntegrationTestSupport'" />
    </ItemGroup>

    <Error Condition="'@(_IntegrationTestSupportReference)' != '' And (('$(IsTestProject)' == 'true' And '$(TestCategory)' == '') Or '$(MSBuildProjectName)' == 'Roslyn.Workbench.Mcp.TestSupport')"
           Text="Project '$(MSBuildProjectName)' must not reference Roslyn.Workbench.Mcp.IntegrationTestSupport. Only integration and audit test projects may consume integration support." />
  </Target>

</Project>
