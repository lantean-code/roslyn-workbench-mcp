                      "format": "uuid"
                    },
                    "alias": {
                      "description": "The optional caller-friendly alias.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "workspaceEpoch": {
                      "description": "The workspace epoch for the loaded baseline.",
