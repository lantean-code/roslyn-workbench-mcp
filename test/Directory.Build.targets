<Project>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <ExpectedTestCategory Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.IntegrationTest'))">Integration</ExpectedTestCategory>
    <ExpectedTestCategory Condition="$([System.String]::Copy('$(MSBuildProjectName)').EndsWith('.AuditTest'))">Audit</ExpectedTestCategory>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true' And '$(TestCategory)' != ''">
    <AssemblyAttribute Include="Xunit.TraitAttribute">
      <_Parameter1>Category</_Parameter1>
      <_Parameter2>$(TestCategory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="ValidateTestProjectCategory" BeforeTargets="CoreCompile" Condition="'$(IsTestProject)' == 'true'">
    <Error Condition="'$(ExpectedTestCategory)' != '' And '$(TestCategory)' != '$(ExpectedTestCategory)'"
           Text="Test project '$(MSBuildProjectName)' must set TestCategory to '$(ExpectedTestCategory)'." />
    <Error Condition="'$(ExpectedTestCategory)' == '' And '$(TestCategory)' != ''"
           Text="Test project '$(MSBuildProjectName)' must use an IntegrationTest or AuditTest suffix when TestCategory is set." />
  </Target>

</Project>
